{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/david12448/travel-site-public/blob/main/schema/restaurant-feed.v1.schema.json",
  "title": "Sanitized restaurant feed for travel consumer (v1)",
  "description": "Public-facing restaurant records; never include source URLs, parser metadata, provider IDs or raw snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "restaurants"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Null only when the list is empty and has not been published."
    },
    "restaurants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/restaurant"
      }
    }
  },
  "$defs": {
    "restaurant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restaurant_id",
        "name",
        "area",
        "destination_ids",
        "cuisine_tags",
        "business_status",
        "last_verified_at",
        "attribution"
      ],
      "properties": {
        "restaurant_id": {
          "type": "string",
          "pattern": "^rst_[A-Za-z0-9_-]{6,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "area": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sido",
            "sigungu"
          ],
          "properties": {
            "sido": {
              "type": "string",
              "minLength": 1
            },
            "sigungu": {
              "type": "string",
              "minLength": 1
            },
            "sido_code": {
              "type": "string"
            },
            "sigungu_code": {
              "type": "string"
            }
          }
        },
        "destination_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "nearby_spot_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "cuisine_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lat",
            "lng"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "address_summary": {
          "type": "string",
          "maxLength": 250
        },
        "business_status": {
          "type": "string",
          "enum": [
            "registered_active",
            "registered_closed",
            "unknown"
          ],
          "description": "Not a real-time open-now indicator."
        },
        "price_per_person": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "min",
            "max",
            "verified_at"
          ],
          "properties": {
            "currency": {
              "const": "KRW"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            },
            "verified_at": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "last_verified_at": {
          "type": "string",
          "format": "date"
        },
        "attribution": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^src_[a-z0-9_-]{8,100}$"
          },
          "uniqueItems": true,
          "description": "Opaque redirect tokens only. Never include destination URLs."
        },
        "recognitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "organization",
              "label",
              "year"
            ],
            "properties": {
              "organization": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "year": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              }
            }
          }
        }
      }
    }
  }
}
